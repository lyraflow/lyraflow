# Template only — this file IS committed. install.sh generates the real .env,
# which is gitignored. Never put real passwords here.
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me

# install.sh also generates these two, the same way, into the same file --
# the credentials for the one admin account. See "Admin login" in the README.
LYRAFLOW_ADMIN_EMAIL=admin@localhost
LYRAFLOW_ADMIN_PASSWORD=change-me

# Browser origins allowed to send events to the write-key ingest routes
# (/v1/track, /v1/page, /v1/identify, /v1/batch). Comma-separated, matched
# exactly -- https://example.com and https://www.example.com are two origins,
# and a scheme is required on each.
#
# Leave it out and every origin is allowed, which is what makes a fresh
# install's tracking snippet work on first paste. Set it and the list is
# exhaustive for the WHOLE install: every domain you instrument has to be in
# it, because creating a project does not extend it.
#
# This is not a security boundary. The write key ships in page source and any
# non-browser sender ignores CORS entirely -- what it buys is stopping someone
# pasting your key on their own site. See "LYRAFLOW_ALLOWED_ORIGINS" in the
# README.
# LYRAFLOW_ALLOWED_ORIGINS=https://acme.example,https://docs.acme.example

# Leave LYRAFLOW_DOMAIN unset for a local trial: the app is published on
# port 3000 and serves plain HTTP, which is what every example in the README
# assumes.
#
# Set it to a hostname that already resolves to this server and install.sh
# adds the two settings below with it. Caddy then takes 80 and 443, obtains a
# certificate, and proxies to the app -- which stops being reachable from
# anywhere but this machine.
#
# The three go together. To turn TLS back off, remove all three lines, then run
# `docker compose --profile tls down` followed by `docker compose up -d`. See
# "Serving over HTTPS" in the README: removing only LYRAFLOW_DOMAIN leaves a
# Caddy with no domain to serve, and a plain `down` leaves the container
# running.
# LYRAFLOW_DOMAIN=analytics.example.com
# COMPOSE_PROFILES=tls
# LYRAFLOW_PUBLISH=127.0.0.1:3000:3000
