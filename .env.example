# Template only — this file IS committed. install.sh generates the real .env,
# which is gitignored. Never put real passwords here.
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me

# Leave LYRAFLOW_DOMAIN unset for a local trial: the app is published on
# port 3000 and serves plain HTTP, which is what every example in the README
# assumes.
#
# Set it to a hostname that already resolves to this server and install.sh
# adds the two settings below with it. Caddy then takes 80 and 443, obtains a
# certificate, and proxies to the app -- which stops being reachable from
# anywhere but this machine.
# LYRAFLOW_DOMAIN=analytics.example.com
# COMPOSE_PROFILES=tls
# LYRAFLOW_PUBLISH=127.0.0.1:3000:3000
